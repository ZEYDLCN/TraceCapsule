<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TraceCapsule.Core\TraceCapsule.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <Description>ASP.NET Core middleware for TraceCapsule: records HTTP request/response bodies, headers, exceptions and trace spans into a redacted .capsule file, with sampling and opt-in [TraceCapsule] endpoint attribution.</Description>
  </PropertyGroup>

</Project>
